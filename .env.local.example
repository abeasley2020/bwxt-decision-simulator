# Copy this to .env.local and fill in your values.
# Never commit .env.local.
#
# Supabase Dashboard > Project Settings > API is where all three values live.

# ─── Required ────────────────────────────────────────────────────────────────

# Project URL and the public anon key. Both are shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key. SERVER ONLY, never prefix this with NEXT_PUBLIC_.
#
# Read by src/lib/supabase/admin.ts (createAdminClient) and by the invite
# route. Six admin and faculty pages call createAdminClient() at render time,
# so without this value a fresh clone throws on every admin page rather than
# degrading. It bypasses row level security entirely: treat it like a
# production database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ─── Not required ────────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_APP_URL was listed here previously. No code reads it. Removed.
#
# RESEND_API_KEY was listed in CLAUDE.md as required. No code reads it either.
# Nothing in this app sends email; the invite route provisions the account
# directly and the credentials are delivered out of band. If a RESEND_API_KEY
# is still set in the Vercel environment it is an unused live credential and
# should be revoked.
